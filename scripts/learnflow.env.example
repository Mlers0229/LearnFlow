# LearnFlow Linux 一键部署配置示例
# 复制为 scripts/learnflow.env 后按实际环境修改。

# 部署目标目录
DEPLOY_ROOT=/opt/LearnFlow
WEB_ROOT=/var/www/learnflow

# 服务运行用户
APP_USER=learnflow
APP_GROUP=learnflow

# 域名
DOMAIN=learnflow.example.com

# 服务端口
BACKEND_PORT=18081
AGENT_PORT=8000

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=learnflow
DB_USER=learnflow_user
DB_PASSWORD=replace_with_strong_password

# Agent / LLM 配置
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=replace_with_real_key
LLM_API_MODEL=deepseek-chat
ENABLE_LLM_PLAN=true

# 是否启用 nginx 站点发布
ENABLE_NGINX=true

# 是否自动安装依赖
INSTALL_PACKAGES=true

# 是否自动创建数据库和用户
SETUP_POSTGRES=true

# 部署快照目录
BACKUP_ROOT=/opt/LearnFlow/.deploy-backups
