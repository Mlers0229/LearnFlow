{
  "schemaVersion": 1,
  "platformSelection": {
    "status": "required",
    "productionDeploymentsBlocked": true,
    "reason": "ADR-0001 requires a managed OCI platform; the provider, region, and budget are not selected."
  },
  "environments": [
    "development",
    "staging",
    "production"
  ],
  "production": {
    "publicEntryService": "frontend",
    "imageReferenceFormat": "repository@sha256:<64-hex-digest>",
    "database": {
      "mode": "managed-postgresql",
      "pitrRequired": true,
      "rpoMinutes": 15,
      "rtoMinutes": 60
    },
    "release": {
      "minimumObservationWindowMinutes": 15,
      "evidenceManifestRequired": true,
      "evidenceDigestAlgorithm": "sha256",
      "automaticStopOnFailedGate": true
    },
    "dataGovernance": {
      "gate": "data-governance",
      "qualifyingEnvironment": "staging",
      "erasureSlaDaysMaximum": 30,
      "productionReleaseBlockedUntilVerified": true,
      "requiredEvidence": [
        "retention-job-results",
        "account-erasure-e2e",
        "object-storage-erasure",
        "data-export-e2e",
        "privacy-approval",
        "data-governance-report"
      ]
    },
    "services": {
      "frontend": {
        "minReplicas": 2,
        "public": true,
        "livenessPath": "/health/live",
        "readinessPath": "/health/ready",
        "runAsNonRoot": true,
        "readOnlyRootFilesystem": true,
        "dropAllCapabilities": true
      },
      "backend": {
        "minReplicas": 2,
        "public": false,
        "livenessPath": "/actuator/health/liveness",
        "readinessPath": "/actuator/health/readiness",
        "runAsNonRoot": true,
        "readOnlyRootFilesystem": true,
        "dropAllCapabilities": true
      },
      "agent": {
        "minReplicas": 2,
        "public": false,
        "livenessPath": "/health/live",
        "readinessPath": "/health/ready",
        "runAsNonRoot": true,
        "readOnlyRootFilesystem": true,
        "dropAllCapabilities": true
      }
    },
    "requiredSecrets": [
      "SPRING_DATASOURCE_PASSWORD",
      "LEARNFLOW_MIGRATION_DB_PASSWORD",
      "LEARNFLOW_AGENT_DB_PASSWORD",
      "LEARNFLOW_JWT_SECRET",
      "LEARNFLOW_PRIVACY_SUBJECT_HASH_PEPPER",
      "LEARNFLOW_AI_AGENT_INTERNAL_TOKEN",
      "LLM_API_KEY",
      "LEARNFLOW_EMBEDDING_API_KEY",
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY"
    ],
    "performance": {
      "gate": "performance-capacity",
      "qualifyingEnvironment": "staging",
      "qualifyingProfiles": [
        "baseline",
        "peak",
        "spike",
        "soak"
      ],
      "ordinaryApiPeakRps": 100,
      "acceptancePeakFactor": 1.5,
      "spikePeakFactor": 2,
      "aiConcurrencyMaximum": 30,
      "evidence": [
        "k6-summary",
        "prometheus-capacity-snapshot",
        "capacity-report",
        "cleanup-record"
      ],
      "productionLoadTestsForbidden": true
    },
    "recovery": {
      "gate": "disaster-recovery",
      "qualifyingEnvironment": "staging",
      "rpoMinutesMaximum": 15,
      "rtoMinutesMaximum": 60,
      "databaseRestoreTarget": "isolated-instance",
      "productionDestructiveDrillsForbidden": true,
      "requiredScenarios": [
        "automatic-backup-pitr",
        "accidental-deletion",
        "database-unavailable",
        "regional-failure",
        "model-provider-outage",
        "queue-backlog-worker-restart"
      ],
      "evidence": [
        "provider-backup-metadata",
        "recovery-timestamps",
        "integrity-check-results",
        "application-smoke-results",
        "alerts-and-traces",
        "cleanup-record",
        "disaster-recovery-report"
      ]
    }
  }
}
