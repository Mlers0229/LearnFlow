POSTGRES_DB=learnflow
POSTGRES_USER=learnflow_owner
POSTGRES_PASSWORD=replace_owner_password
LEARNFLOW_MIGRATION_DB_PASSWORD=replace_migrator_password
LEARNFLOW_BACKEND_DB_PASSWORD=replace_backend_password
LEARNFLOW_AGENT_DB_PASSWORD=replace_agent_password
LEARNFLOW_ENV=development

BACKEND_PORT=18081
FRONTEND_PORT=80
LEARNFLOW_AI_AGENT_INTERNAL_TOKEN=replace_with_a_long_random_secret
LEARNFLOW_AI_AGENT_PREVIOUS_INTERNAL_TOKEN=
LEARNFLOW_AI_CONNECT_TIMEOUT=3s
LEARNFLOW_AI_WRITE_TIMEOUT=15s
LEARNFLOW_AI_READ_TIMEOUT=60s
LEARNFLOW_AI_ADMIN_BUDGET=10s
LEARNFLOW_AI_RAG_BUDGET=15s
LEARNFLOW_AI_TUTOR_BUDGET=45s
LEARNFLOW_AI_PLAN_BUDGET=90s
LEARNFLOW_AI_STREAM_BUDGET=5m
LEARNFLOW_AI_STREAM_IDLE_TIMEOUT=60s
LEARNFLOW_AI_MAX_CONNECTIONS=30
LEARNFLOW_AI_MAX_IDLE_CONNECTIONS=10
LEARNFLOW_AI_RETRY_MAX_ATTEMPTS=2
LEARNFLOW_AI_RETRY_WAIT=100ms
LEARNFLOW_AI_CIRCUIT_FAILURE_RATE=50
LEARNFLOW_AI_CIRCUIT_MINIMUM_CALLS=5
LEARNFLOW_AI_CIRCUIT_OPEN_WAIT=20s
LEARNFLOW_AI_CIRCUIT_HALF_OPEN_CALLS=2
LEARNFLOW_AI_BULKHEAD_WAIT=0ms
LEARNFLOW_AI_ADMIN_CONCURRENCY=4
LEARNFLOW_AI_RAG_CONCURRENCY=8
LEARNFLOW_AI_TUTOR_CONCURRENCY=8
LEARNFLOW_AI_PLAN_CONCURRENCY=4
LEARNFLOW_AI_STREAM_CONCURRENCY=6
LEARNFLOW_BACKEND_DB_POOL_SIZE=15
LEARNFLOW_BACKEND_DB_POOL_MIN_IDLE=2
LEARNFLOW_BACKEND_DB_POOL_ACQUIRE_TIMEOUT=3000
LEARNFLOW_AGENT_DB_POOL_SIZE=5
LEARNFLOW_AGENT_DB_POOL_OVERFLOW=0
LEARNFLOW_AGENT_DB_POOL_ACQUIRE_TIMEOUT=5
LEARNFLOW_SHUTDOWN_TIMEOUT=30s
LEARNFLOW_TASKS_ENABLED=true
LEARNFLOW_TASKS_CONCURRENCY=2
LEARNFLOW_TASKS_MAX_ATTEMPTS=3
LEARNFLOW_TASKS_LEASE_DURATION=3m
LEARNFLOW_TASKS_TIMEOUT=10m
LEARNFLOW_TASKS_RETRY_BASE_DELAY=5s
LEARNFLOW_TASKS_FAILED_PAYLOAD_RETENTION=7d
LEARNFLOW_TASKS_FAILED_PAGE_SIZE=50
LEARNFLOW_TASKS_CLEANUP_CRON="0 41 3 * * *"
LEARNFLOW_RESOURCE_INGESTION_ENABLED=true
LEARNFLOW_RESOURCE_MAX_SOURCE_BYTES=10485760
LEARNFLOW_RESOURCE_MAX_EXTRACTED_CHARACTERS=2000000
LEARNFLOW_RESOURCE_CHUNK_TARGET_CHARACTERS=1200
LEARNFLOW_RESOURCE_CHUNK_MAX_CHARACTERS=1800
LEARNFLOW_RESOURCE_MAX_REDIRECTS=5
LEARNFLOW_RESOURCE_CONNECT_TIMEOUT=5s
LEARNFLOW_RESOURCE_READ_TIMEOUT=30s
# development 可使用 filesystem；production 必须使用 s3 和部署平台 Secret 注入的 AWS 凭证。
LEARNFLOW_RESOURCE_STORAGE_TYPE=filesystem
LEARNFLOW_RESOURCE_STORAGE_PATH=/var/lib/learnflow/resource-sources
LEARNFLOW_RESOURCE_STORAGE_BUCKET=
LEARNFLOW_RESOURCE_STORAGE_REGION=us-east-1
LEARNFLOW_RESOURCE_STORAGE_ENDPOINT=
LEARNFLOW_RESOURCE_STORAGE_PREFIX=learnflow
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LEARNFLOW_EMBEDDING_ENABLED=false
LEARNFLOW_EMBEDDING_PROVIDER=openai-compatible
LEARNFLOW_EMBEDDING_API_BASE=https://api.example.com
LEARNFLOW_EMBEDDING_API_KEY=replace_me
LEARNFLOW_EMBEDDING_MODEL=text-embedding-3-small
LEARNFLOW_EMBEDDING_VERSION=text-embedding-3-small-v1
LEARNFLOW_EMBEDDING_DIMENSIONS=1536
LEARNFLOW_EMBEDDING_BATCH_SIZE=32
LEARNFLOW_EMBEDDING_BACKFILL_PAGE_SIZE=20
LEARNFLOW_EMBEDDING_BACKFILL_INTERVAL_MS=30000
LEARNFLOW_EMBEDDING_READ_TIMEOUT=30
LEARNFLOW_EMBEDDING_MAX_CONCURRENT_CALLS=6
LEARNFLOW_EMBEDDING_BULKHEAD_WAIT=0.1
LEARNFLOW_EMBEDDING_CIRCUIT_FAILURE_THRESHOLD=5
LEARNFLOW_EMBEDDING_CIRCUIT_OPEN_SECONDS=20
LEARNFLOW_EMBEDDING_CIRCUIT_HALF_OPEN_CALLS=1
LEARNFLOW_AGENT_GRACEFUL_SHUTDOWN_TIMEOUT=30
LEARNFLOW_LLM_CONNECT_TIMEOUT=5
LEARNFLOW_LLM_READ_TIMEOUT=60
LEARNFLOW_LLM_WRITE_TIMEOUT=15
LEARNFLOW_LLM_POOL_TIMEOUT=5
LEARNFLOW_LLM_MAX_CONNECTIONS=30
LEARNFLOW_LLM_MAX_KEEPALIVE_CONNECTIONS=10
LEARNFLOW_LLM_MAX_CONCURRENT_CALLS=12
LEARNFLOW_LLM_BULKHEAD_WAIT=0.1
LEARNFLOW_LLM_CIRCUIT_FAILURE_THRESHOLD=5
LEARNFLOW_LLM_CIRCUIT_OPEN_SECONDS=20
LEARNFLOW_LLM_CIRCUIT_HALF_OPEN_CALLS=1
LEARNFLOW_JWT_SECRET=replace_with_at_least_32_random_bytes
LEARNFLOW_JWT_KEY_ID=current-2026-08
LEARNFLOW_JWT_PREVIOUS_SECRET=
LEARNFLOW_JWT_PREVIOUS_KEY_ID=previous
LEARNFLOW_SECURE_COOKIE=false
LEARNFLOW_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
LEARNFLOW_AGENT_LOG_MAX_PAYLOAD_BYTES=4096
LEARNFLOW_AGENT_LOG_RETENTION_DAYS=30
LEARNFLOW_AUDIT_RETENTION=365d
LEARNFLOW_AUDIT_MAX_DETAIL_LENGTH=2048
LEARNFLOW_AUDIT_CLEANUP_CRON="0 17 3 * * *"
LEARNFLOW_PASSWORD_RESET_ENABLED=false
LEARNFLOW_PASSWORD_RESET_TTL=20m
LEARNFLOW_PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
LEARNFLOW_PASSWORD_RESET_MAIL_FROM=no-reply@learnflow.local
LEARNFLOW_PASSWORD_RESET_MAX_REQUESTS=3
LEARNFLOW_PASSWORD_RESET_REQUEST_WINDOW=30m
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
LEARNFLOW_LLM_ALLOWED_HOSTS=api.example.com
LEARNFLOW_ALLOW_INSECURE_LLM_HTTP=false
FLYWAY_BASELINE_ON_MIGRATE=false

# OpenTelemetry is opt-in. Start the local backend with:
# docker compose --profile observability up -d
LEARNFLOW_OTEL_ENABLED=false
LEARNFLOW_TRACE_SAMPLE_PROBABILITY=0.10
LEARNFLOW_RELEASE_VERSION=development
LEARNFLOW_METRICS_EXPORT_INTERVAL_MS=30000
LEARNFLOW_METRICS_EXPORT_STEP=30s
LEARNFLOW_QUEUE_METRICS_INTERVAL_MS=15000
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics
JAEGER_UI_PORT=16686
OTEL_HTTP_PORT=4318
OTEL_PROMETHEUS_PORT=9464
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=learnflow_admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_strong_secret
# Keep zero until rates are explicitly configured for the deployed model.
LEARNFLOW_LLM_INPUT_USD_PER_1M_TOKENS=0
LEARNFLOW_LLM_OUTPUT_USD_PER_1M_TOKENS=0

LLM_API_BASE=https://api.example.com
LLM_API_KEY=replace_me
LLM_API_MODEL=deepseek-chat
ENABLE_LLM_PLAN=true

PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com
MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,postgres,backend,agent,frontend
